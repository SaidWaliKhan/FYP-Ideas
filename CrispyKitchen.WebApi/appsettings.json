{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=CrispyKitchenDb;User Id=sa;Password=crispy-kitchen@18;TrustServerCertificate=True;"
  },

  "Jwt": {
  "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
  "Issuer": "CrispyKitchen",
  "Audience": "CrispyKitchenClient",
